# Copie para .env.local (NÃO versionar) e preencha.
OPENAI_API_KEY=
# Modelo usado pelo agente (server-side).
OPENAI_MODEL=gpt-5-mini
# Esforço de raciocínio (modelos gpt-5*/o*): minimal | low | medium | high. Padrão: low (menor latência).
OPENAI_REASONING_EFFORT=low
# Modelo de transcrição da reunião (padrão gpt-4o-mini-transcribe; fallback whisper-1)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
