# Copie para .env.local e preencha. Nunca versione chaves reais.
OPENAI_API_KEY=
# Modelo do agente (server-side)
OPENAI_MODEL=gpt-5-mini
# Esforço de raciocínio: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low
# Transcrição da reunião (fallback automático: whisper-1)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
